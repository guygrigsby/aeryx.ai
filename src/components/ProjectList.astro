---
import { projects } from '../lib/projects';
---
<section class="section" id="projects">
  <div class="wrap">
    <p class="label">What I'm building</p>
    <h2>Projects</h2>
    <ul class="projects">
      {projects.map((p) => (
        <li class="project">
          <h3>{p.name}{p.gloss && <span class="gloss"> — {p.gloss}</span>}</h3>
          <p>{p.summary}</p>
          <p class="status">{p.status}</p>
          <p class="links">
            {p.site && <a href={p.site} target="_blank" rel="noopener">{p.site.replace('https://', '')} →</a>}
            <a href={p.repo} target="_blank" rel="noopener">github →</a>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects { list-style: none; display: grid; gap: var(--aeryx-s-6); margin-top: var(--aeryx-s-5); }
  .gloss { color: var(--aeryx-faint); font-weight: 400; font-style: italic; }
  .project p { color: var(--aeryx-muted); }
  .status { color: var(--aeryx-faint); font-size: 0.85rem; font-family: var(--aeryx-mono); }
  .links { display: flex; flex-wrap: wrap; gap: var(--aeryx-s-4); }
</style>
