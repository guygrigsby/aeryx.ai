---
import { projects } from '../lib/projects';
import { research, hfProfile } from '../lib/research';

// Email parts stay separate; they are only joined inside the bundled JS at
// runtime, so the assembled address never appears in static HTML.
const ctx = {
  projects,
  research,
  hfProfile,
  email: { user: 'guy', domain: 'grigsby.dev' },
};
---
<div class="term" role="region" aria-label="interactive terminal">
  <div class="term-bar"><span></span><span></span><span></span><em>aeryx</em></div>
  <div id="screen" class="term-screen" aria-live="polite"></div>
  <div class="term-input-row">
    <span class="term-prompt">aeryx ~ %</span>
    <input id="input" class="term-input" autocomplete="off" spellcheck="false"
           aria-label="terminal command input" placeholder="ask a question, or tap below" />
  </div>
  <div class="chips" role="group" aria-label="suggested questions">
    <button class="chip" data-cmd="what do you build?">what do you build?</button>
    <button class="chip" data-cmd="how do I reach you?">how do I reach you?</button>
    <button class="chip" data-cmd="what's your research?">research</button>
    <button class="chip" data-cmd="are you available?">are you available?</button>
  </div>
</div>

<script type="application/json" id="term-ctx" is:inline set:html={JSON.stringify(ctx)}></script>

<script>
  import { createTerminal } from '../scripts/terminal.ts';

  const ctxEl = document.getElementById('term-ctx');
  const screen = document.getElementById('screen');
  const input = document.getElementById('input') as HTMLInputElement | null;

  if (ctxEl && screen && input) {
    const ctx = JSON.parse(ctxEl.textContent ?? '{}');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const term = createTerminal({ screen, input, ctx, instant: reduce });

    // intro
    term.submit('hello');

    document.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => {
      b.addEventListener('click', () => {
        const cmd = b.getAttribute('data-cmd');
        if (cmd) term.submit(cmd);
        input.focus();
      });
    });
  }
</script>

<style>
  /* Chrome, dots and borders come from brand.css `.term`. Only the live
     screen and its input row are aeryx.ai's own. */
  .term { font-size: 0.9rem; box-shadow: var(--aeryx-glow-hero); }
  .term-screen {
    padding: var(--aeryx-s-4);
    min-height: 220px;
    max-height: 360px;
    overflow-y: auto;
    font-family: var(--aeryx-mono);
  }
  .term-screen :global(.line) { white-space: pre-wrap; }
  .term-screen :global(.prompt) { color: var(--aeryx-faint); }
  .term-screen :global(.muted) { color: var(--aeryx-muted); }
  .term-screen :global(.accent) { color: var(--aeryx-accent); }
  .term-screen :global(.error) { color: var(--aeryx-error); }
  .term-screen :global(a) { color: var(--aeryx-accent); }
  .term-input-row {
    display: flex;
    gap: var(--aeryx-s-2);
    padding: var(--aeryx-s-2) var(--aeryx-s-4);
    border-top: 1px solid var(--aeryx-border);
  }
  .term-prompt { color: var(--aeryx-faint); font-family: var(--aeryx-mono); }
  .term-input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--aeryx-text);
    font: inherit;
    font-family: var(--aeryx-mono);
    outline: none;
  }
  .chips { display: flex; flex-wrap: wrap; gap: var(--aeryx-s-2); padding: var(--aeryx-s-3) var(--aeryx-s-4); }
  .chip {
    background: var(--aeryx-raised);
    color: var(--aeryx-accent);
    border: 1px solid var(--aeryx-border);
    border-radius: 999px;
    padding: var(--aeryx-s-1) var(--aeryx-s-3);
    font: inherit;
    font-family: var(--aeryx-mono);
    font-size: 0.8rem;
    cursor: pointer;
    transition: background var(--aeryx-t-micro) var(--aeryx-ease);
  }
  .chip:hover { background: var(--aeryx-600); }
</style>
