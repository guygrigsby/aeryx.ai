---
// Sock's own pages, in Sock's identity rather than aeryx's: the near-black
// ground, grey type and one blood red accent of the app, and the Sock
// wordmark from the brand pack (public/sock). Self-contained: none of the
// aeryx styles load here.
import { legalName, supportAddress } from '../lib/site';
interface Props { title: string; description: string; heading?: string; effective?: string; hero?: boolean; }
const { title, description, heading, effective, hero = false } = Astro.props;
const addr = supportAddress();
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/sock/emblem.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/sock/wordmark.svg" />
    <meta name="theme-color" content="#0a0a0b" />
  </head>
  <body class="sock">
    <header class="bar">
      <a class="brand" href="/sock/" aria-label="Sock home">
        <img src="/sock/wordmark.svg" alt="Sock" width="135" height="56" />
      </a>
      <nav aria-label="Sock">
        <a href="/sock/support">Support</a>
        <a href="/sock/terms">Terms</a>
        <a href="/sock/privacy">Privacy</a>
      </nav>
    </header>
    <main class={hero ? 'hero' : 'doc'}>
      {heading && <h1>{heading}</h1>}
      {effective && <p class="effective">{effective}</p>}
      <slot />
    </main>
    <footer class="foot">
      <a href={`mailto:${addr}`}>support@aeryx.ai</a>
      <span>© {year} {legalName}</span>
    </footer>
  </body>
</html>

<style is:global>
  .sock {
    --ground: #0a0a0b;
    --panel: #111113;
    --text: #ededef;
    --secondary: #a1a1a6;
    --meta: #7c7c82;
    --line: rgba(255, 255, 255, 0.08);
    --blood: #8b0a14;
    --accent: #e04048;
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--ground);
    color: var(--text);
    color-scheme: dark;
    font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .sock a { color: var(--accent); text-underline-offset: 3px; }
  .sock .bar, .sock main, .sock .foot {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
    box-sizing: border-box;
  }
  .sock .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .sock .brand { display: block; line-height: 0; }
  .sock .brand img { height: 48px; width: auto; }
  .sock .bar nav { display: flex; gap: 20px; font-size: 0.95rem; }
  .sock .bar nav a { color: var(--secondary); text-decoration: none; }
  .sock .bar nav a:hover { color: var(--text); }
  .sock main { flex: 1; padding-top: 56px; padding-bottom: 96px; }
  .sock h1 { font-size: 2.2rem; line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 6px; }
  .sock h2 { font-size: 1.05rem; margin: 40px 0 8px; }
  .sock p, .sock li { color: var(--secondary); max-width: 64ch; }
  .sock p + p { margin-top: 12px; }
  .sock ul { padding-left: 1.2rem; }
  .sock li + li { margin-top: 4px; }
  .sock strong { color: var(--text); }
  .sock .effective { font-size: 0.85rem; color: var(--meta); letter-spacing: 0.02em; margin: 0 0 24px; }
  .sock .lede { color: var(--text); font-size: 1.1rem; }
  .sock table { border-collapse: collapse; width: 100%; font-size: 0.92rem; margin-top: 8px; }
  .sock th, .sock td { text-align: left; vertical-align: top; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); color: var(--secondary); }
  .sock th { color: var(--meta); font-weight: 500; }
  .sock .hero { text-align: left; padding-top: 72px; }
  .sock .hero .mark { width: 120px; height: 120px; display: block; margin-bottom: 28px; }
  .sock .hero h1 { font-size: 2.8rem; }
  .sock .hero .tagline { text-transform: uppercase; letter-spacing: 0.32em; font-size: 0.8rem; color: var(--meta); margin: 4px 0 36px; }
  .sock .links { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 32px; }
  .sock .shots { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; margin-top: 8px; }
  .sock .shots img { flex: none; height: auto; border-radius: 14px; scroll-snap-align: start; }
  .sock .shots.phone img { width: 220px; }
  .sock .shots.mac img { width: 100%; }
  .sock .pill {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--blood);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .sock .foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 20px;
    padding-bottom: 28px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--meta);
  }
  @media (max-width: 560px) {
    .sock .brand img { height: 40px; }
    .sock .bar nav { gap: 14px; font-size: 0.9rem; }
    .sock h1 { font-size: 1.8rem; }
    .sock table, .sock thead, .sock tbody, .sock tr, .sock th, .sock td { display: block; }
    .sock thead { display: none; }
    .sock td { border-bottom: none; padding: 2px 0; }
    .sock tr { border-bottom: 1px solid var(--line); padding: 10px 0; }
  }
</style>
